# Supabase credentials — get these from your Supabase project settings
# https://supabase.com/dashboard → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Service role key — used server-side for write operations (bypasses RLS)
# NEVER expose this in the browser — no NEXT_PUBLIC_ prefix
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# tldraw hobby license key — removes watermark on licensed domains
# Apply at https://tldraw.dev/get-a-license/hobby
NEXT_PUBLIC_TLDRAW_LICENSE_KEY=your-tldraw-license-key-here
